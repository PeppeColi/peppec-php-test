{
    "name": "peppecoli/peppec-php-test",
    "description": "Minimal PHP project used to test the PEPPEC php-v1 preset",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "PeppecPhpTest\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PeppecPhpTest\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
